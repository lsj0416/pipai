# =============================================================
# PIPAi Backend 환경변수 예시
# 이 파일을 복사해서 .env 로 저장 후 실제 값 입력
# .env 파일은 절대 커밋하지 마세요
# =============================================================

# ── Database ──────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pipai
SPRING_DATASOURCE_USERNAME=pipai
SPRING_DATASOURCE_PASSWORD=pipai

# ── JWT ────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열 (openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── 법제처 Open API ────────────────────────────────────────────
# https://www.law.go.kr/DRF 에서 OC 인증값 발급
LAW_API_KEY=your-law-api-oc-key

# ── 개인정보보호위원회 공공데이터 API ──────────────────────────
# https://www.data.go.kr 에서 서비스키 발급
PIPC_API_KEY=your-pipc-api-service-key
